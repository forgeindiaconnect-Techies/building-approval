aA# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.s0scyhq.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=Cluster0

# Backend Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Node Environment
NODE_ENV=development

# Cloudinary Image & Document Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Accessible Cloudinary Variables (Vite)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# Brevo (Sendinblue) Email Notifications Credentials
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
